#!/bin/bash
# SPDX-License-Identifier: GPL-3.0-only
# Copyright 2026 Canonical Ltd.

set -euo pipefail

if systemd-detect-virt --container --quiet || ! systemd-detect-virt --vm --quiet; then
  echo "The Rockcraft SDK requires runtime: lxd-vm in the workshop definition." >&2
  exit 1
fi

apt-get update
eatmydata apt-get install --yes jq ca-certificates snapd

ARCH=$(dpkg --print-architecture)
REVISION=$(jq -er --arg arch "$ARCH" '
  .revisions[$arch] |
  if type == "string" and test("^[1-9][0-9]*$") then .
  else error("no pinned Rockcraft snap revision for " + $arch) end
' "$SDK/rockcraft-snap.json")

snap wait system seed.loaded
snap install rockcraft --classic --revision="$REVISION"
# Keep the snap at the SDK's version; updates come through SDK refreshes.
snap refresh --hold rockcraft

ln -sf /snap/bin/rockcraft /usr/local/bin/rockcraft

lxd waitready
PROFILE=$(lxc query /1.0/profiles/default)
if ! jq -e 'any(.devices[]; .type == "disk" and .path == "/")' <<<"$PROFILE" >/dev/null; then
  lxd init --auto
fi
usermod -a -G lxd workshop
